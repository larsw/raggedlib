# Host path of the Calibre library (mounted read-only into the backend)
CALIBRE_LIBRARY=${HOME}/Documents/CalibreLibrary
EMBED_MODEL=qwen3-embedding:0.6b
CHAT_MODEL=qwen3.5:9b
# Tesseract languages for OCR of scanned PDFs, '+'-separated (eng+nor+deu): installed into the backend image and used
# for every scanned book, besides its Calibre languages. Rebuild the backend after changing: docker compose up -d --build backend
OCR_LANGUAGES=eng
# API key for the MCP endpoint (http://localhost:8080/mcp), e.g. from: openssl rand -hex 32
# Instead of the key itself you can give its hash: sha256:<hex of sha256(key)>. More keys: see README.
MCP_API_KEY=
MCP_API_KEY_NAME=default
