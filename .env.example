# Host path of the (first) Calibre library (mounted read-only into the backend)
CALIBRE_LIBRARY=${HOME}/Documents/CalibreLibrary
#CALIBRE_LIBRARY_NAME=default
# For a second library: uncomment its volume in docker-compose.yml and set CALIBRE_LIBRARY_1 (+ its
# RAGGEDLIB_LIBRARIES_1_NAME there). More libraries: repeat with CALIBRE_LIBRARY_2 at index 2, and so on. See README.
#CALIBRE_LIBRARY_1=${HOME}/Documents/CalibreLibraryMisc
EMBED_MODEL=qwen3-embedding:0.6b
CHAT_MODEL=qwen3.5:9b
# Tesseract languages for OCR of scanned PDFs, '+'-separated (eng+nor+deu): installed into the backend image and used
# for every scanned book, besides its Calibre languages. Rebuild the backend after changing: docker compose up -d --build backend
OCR_LANGUAGES=eng
# Sign-in: oidc (default: users sign in) or single-user (no sign-in; every request without an API key is the local
# admin, as before multi-user support; keep the ports on localhost then).
#AUTH_MODE=single-user
# With AUTH_MODE=oidc, the provider. `dex` (default): the bundled development dex (infra/dex/config.yaml;
# gadmin / gadmin, gcurator / gcurator, ...). `oidc`: your own OpenID Connect provider, below.
#SPRING_PROFILES_ACTIVE=dex
# Your own provider (with SPRING_PROFILES_ACTIVE=oidc); register <web UI origin>/api/auth/callback/oidc as redirect URI
#OIDC_ISSUER_URI=https://idp.example.com/realms/home
#OIDC_CLIENT_ID=raggedlib
#OIDC_CLIENT_SECRET=
#OIDC_SCOPES=openid,profile,email,groups
# Groups (in the `groups` claim) whose members are global admins, comma-separated
#AUTH_ADMIN_GROUPS=administrators
# Role every signed-in user has in every library: none, viewer or curator
#AUTH_DEFAULT_LIBRARY_ROLE=none
# MCP: users mint their own API keys in the web UI (Account → API keys), admins system-wide ones (Administration).
# Optionally one more system-wide key (library:read on every library) from here, e.g. from: openssl rand -hex 32.
# Instead of the key itself you can give its hash: sha256:<hex of sha256(key)>.
MCP_API_KEY=
MCP_API_KEY_NAME=default
